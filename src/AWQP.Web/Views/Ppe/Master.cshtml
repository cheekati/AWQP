@{
    ViewData["Title"] = "PPE Master";
}
<partial name="_PpeNav" />
<section class="hero-panel mb-4 d-flex justify-content-between align-items-center">
    <div>
        <p class="text-uppercase text-muted mb-1">MARUWA EHS System</p>
        <h1 class="display-6 fw-bold mb-0">PPE Master</h1>
    </div>
    <button class="btn btn-primary btn-lg" id="btn-add-item">+ Add PPE Item</button>
</section>

<div id="alert-box"></div>

<div class="card">
    <div class="card-header fw-semibold">PPE Items</div>
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th><th>Name</th><th>Category</th><th class="text-end">Price</th>
                    <th class="text-end">Lifetime (months)</th><th>UoM</th><th class="text-end">Existing Qty</th><th></th>
                </tr>
            </thead>
            <tbody id="items-grid"><tr><td colspan="8" class="text-center text-muted py-4">Loading…</td></tr></tbody>
        </table>
    </div>
</div>

<!-- Add/Edit popup -->
<div class="modal fade" id="item-modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="item-modal-title">Add PPE Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="f-id" />
                <div class="mb-2"><label class="form-label">Item Code *</label><input class="form-control" id="f-code" required /></div>
                <div class="mb-2"><label class="form-label">Name *</label><input class="form-control" id="f-name" required /></div>
                <div class="mb-2"><label class="form-label">Category *</label><input class="form-control" id="f-category" required /></div>
                <div class="row">
                    <div class="col mb-2"><label class="form-label">Price *</label><input type="number" min="0.01" step="0.01" class="form-control" id="f-price" required /></div>
                    <div class="col mb-2"><label class="form-label">Lifetime (months) *</label><input type="number" min="1" class="form-control" id="f-lifetime" required /></div>
                </div>
                <div class="mb-2"><label class="form-label">Unit of Measure *</label><input class="form-control" id="f-uom" value="EA" required /></div>
                <div class="text-danger small" id="form-error"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" id="btn-save-item">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>window.PPE_CONFIG = { apiBase: '@ViewBag.ApiBaseUrl', token: '@ViewBag.ApiToken' };</script>
    <script src="~/js/ppe.js"></script>
    <script>
        (function () {
            const modalEl = document.getElementById('item-modal');
            const modal = new bootstrap.Modal(modalEl);

            function alertMsg(msg, ok) {
                $('#alert-box').html('<div class="alert alert-' + (ok ? 'success' : 'danger') + ' alert-dismissible">' + PPE.escapeHtml(msg) + '<button class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            function load() {
                PPE.api('/api/ehs/ppe-items').done(function (rows) {
                    if (!rows.length) { $('#items-grid').html('<tr><td colspan="8" class="text-center text-muted py-4">No PPE items yet.</td></tr>'); return; }
                    $('#items-grid').html(rows.map(function (r) {
                        return '<tr>' +
                            '<td><strong>' + PPE.escapeHtml(r.itemCode) + '</strong></td>' +
                            '<td>' + PPE.escapeHtml(r.name) + '</td>' +
                            '<td>' + PPE.escapeHtml(r.category) + '</td>' +
                            '<td class="text-end">' + PPE.money(r.price) + '</td>' +
                            '<td class="text-end">' + r.lifetimeMonths + '</td>' +
                            '<td>' + PPE.escapeHtml(r.unitOfMeasure) + '</td>' +
                            '<td class="text-end">' + r.existingQuantity + '</td>' +
                            '<td class="text-end"><button class="btn btn-sm btn-outline-primary btn-edit" ' +
                                'data-id="' + r.id + '" data-code="' + PPE.escapeHtml(r.itemCode) + '" data-name="' + PPE.escapeHtml(r.name) + '" ' +
                                'data-category="' + PPE.escapeHtml(r.category) + '" data-price="' + r.price + '" data-lifetime="' + r.lifetimeMonths + '" ' +
                                'data-uom="' + PPE.escapeHtml(r.unitOfMeasure) + '">Edit</button></td>' +
                            '</tr>';
                    }).join(''));
                }).fail(function (xhr) { alertMsg(PPE.errorText(xhr), false); });
            }

            function openAdd() {
                $('#item-modal-title').text('Add PPE Item');
                $('#f-id').val(''); $('#f-code').val('').prop('disabled', false);
                $('#f-name').val(''); $('#f-category').val(''); $('#f-price').val(''); $('#f-lifetime').val(''); $('#f-uom').val('EA');
                $('#form-error').text(''); modal.show();
            }

            $('#btn-add-item').on('click', openAdd);

            $('#items-grid').on('click', '.btn-edit', function () {
                const d = $(this).data();
                $('#item-modal-title').text('Edit PPE Item');
                $('#f-id').val(d.id);
                $('#f-code').val(d.code).prop('disabled', true);
                $('#f-name').val(d.name); $('#f-category').val(d.category);
                $('#f-price').val(d.price); $('#f-lifetime').val(d.lifetime); $('#f-uom').val(d.uom);
                $('#form-error').text(''); modal.show();
            });

            $('#btn-save-item').on('click', function () {
                const id = $('#f-id').val();
                const body = {
                    itemCode: $('#f-code').val().trim(),
                    name: $('#f-name').val().trim(),
                    category: $('#f-category').val().trim(),
                    price: parseFloat($('#f-price').val()),
                    lifetimeMonths: parseInt($('#f-lifetime').val(), 10),
                    unitOfMeasure: $('#f-uom').val().trim()
                };
                if (!body.itemCode || !body.name || !body.category || !(body.price > 0) || !(body.lifetimeMonths > 0) || !body.unitOfMeasure) {
                    $('#form-error').text('All fields are mandatory.'); return;
                }
                const req = id
                    ? PPE.api('/api/ehs/ppe-items/' + id, 'PUT', { name: body.name, category: body.category, price: body.price, lifetimeMonths: body.lifetimeMonths, unitOfMeasure: body.unitOfMeasure })
                    : PPE.api('/api/ehs/ppe-items', 'POST', body);
                req.done(function () { modal.hide(); alertMsg('PPE item saved.', true); load(); })
                   .fail(function (xhr) { $('#form-error').text(PPE.errorText(xhr)); });
            });

            load();
        })();
    </script>
}
